---
import MainLayout from "../layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations, defaultLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === defaultLang ? "" : `/${lang}`;
---

<MainLayout title={t("site.title")} description={t("site.description")}>
  <!-- Hero -->
  <section class="pt-48 px-6">
    <div class="max-w-5xl mx-auto">
      <h1
        class="text-6xl md:text-8xl font-extrabold tracking-tight mb-8 leading-[1.1]"
        set:html={t("hero.title")}
      />
      <p
        class="text-xl md:text-2xl max-w-2xl leading-relaxed dark:text-slate-400"
        style="color: var(--text-secondary);"
        set:html={t("hero.description")}
      />
    </div>
    <div class="w-48 h-32 mt-16 ml-auto mr-16">
      <img src="/img/android-head_3D.svg" alt="Android Robot Head Image" />
    </div>
  </section>

  <!-- Portfolio -->
  <section
    id="work"
    class="py-24 px-6 dark:bg-slate-800"
    style="background-color: var(--bg-secondary);"
  >
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-end mb-16">
        <div>
          <h2 class="text-4xl font-bold mb-4">{t("work.title")}</h2>
          <p class="dark:text-slate-400" style="color: var(--text-secondary);">
            {t("work.subtitle")}
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- App Card 1 -->
        <a
          href={`${prefix}/ambiance/`}
          class="app-card group block p-8 rounded-[2.5rem] transition-all border hover:border-yellow-200 soft-shadow dark:bg-slate-700 dark:border-slate-600"
          style="background-color: var(--bg-card); border-color: var(--border-color);"
        >
          <div class="flex justify-between items-start mb-12">
            <div
              class="app-icon w-20 h-20 ambient-app-gradient rounded-3xl flex items-center justify-center shadow-sm transition-transform duration-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="40"
                height="40"
                viewBox="0 0 22 17"
              >
                <path
                  fill="#2196F3"
                  d="M1.02 17c-0.42 0-0.72-0.18-0.9-0.55-0.19-0.37-0.15-0.72 0.1-1.05l4-5.33c0.1-0.13 0.22-0.23 0.36-0.3 0.14-0.06 0.29-0.1 0.44-0.1 0.15 0 0.3 0.04 0.43 0.1 0.15 0.07 0.27 0.17 0.37 0.3L9.52 15h7.5l-5-6.65-1.7 2.25c-0.2 0.27-0.44 0.4-0.7 0.41-0.27 0.01-0.5-0.06-0.7-0.21-0.2-0.15-0.34-0.35-0.4-0.61-0.07-0.26 0-0.52 0.2-0.79l2.5-3.33c0.1-0.13 0.22-0.23 0.36-0.3 0.14-0.06 0.29-0.1 0.44-0.1 0.15 0 0.3 0.04 0.43 0.1 0.15 0.07 0.27 0.17 0.37 0.3l7 9.33c0.25 0.33 0.28 0.68 0.1 1.05-0.19 0.37-0.49 0.55-0.9 0.55h-18Z"
                ></path>
                <circle fill="#FFC107" cx="18.02" cy="3" r="3"></circle>
              </svg>
            </div>
            <span
              class="bg-yellow-100 text-yellow-700 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest"
              >{t("ambiance.tag")}</span
            >
          </div>
          <h3 class="text-3xl font-bold mb-4">{t("ambiance.title")}</h3>
          <p
            class="mb-6 leading-relaxed dark:text-slate-300"
            style="color: var(--text-secondary);"
          >
            {t("ambiance.description")}
          </p>
          <span
            class="text-yellow-600 font-bold group-hover:translate-x-2 inline-block transition-transform"
            set:html={t("ambiance.explore")}
          />
        </a>

        <!-- App Card 2 (Teaser) -->
        <div
          class="p-8 rounded-[2.5rem] border border-dashed flex flex-col justify-center items-center text-center dark:bg-slate-700 dark:border-slate-600"
          style="background-color: var(--bg-card-alt); border-color: var(--border-color);"
        >
          <div
            class="w-16 h-16 bg-white rounded-full flex items-center justify-center mb-6 text-2xl grayscale opacity-30"
          >
            &#x23F3;
          </div>
          <h3
            class="text-xl font-bold dark:text-slate-500"
            style="color: var(--text-tertiary);"
          >
            {t("project.citrus.title")}
          </h3>
          <p
            class="text-sm max-w-[200px] dark:text-slate-500"
            style="color: var(--text-tertiary);"
          >
            {t("project.citrus.description")}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Custom Dev Section -->
  <section id="custom" class="py-32 px-6">
    <div
      class="max-w-4xl mx-auto flex flex-col md:flex-row gap-16 items-center"
    >
      <div class="flex-1">
        <div
          class="inline-block px-4 py-1 bg-yellow-400 text-white font-bold text-xs uppercase tracking-tighter rounded mb-6"
        >
          {t("custom.tag")}
        </div>
        <h2 class="text-5xl font-extrabold mb-8">{t("custom.title")}</h2>
        <p
          class="text-lg leading-relaxed mb-8 dark:text-slate-400"
          style="color: var(--text-secondary);"
        >
          {t("custom.description")}
        </p>
        <a
          href="mailto:hello@lemonslice.de"
          class="text-xl font-bold border-b-4 border-yellow-400 pb-1 hover:text-yellow-600 transition"
        >
          {t("custom.cta")}
        </a>
      </div>
      <div class="flex-1 grid grid-cols-2 gap-4">
        <div
          class="h-40 rounded-3xl soft-shadow flex flex-col justify-center p-6 dark:bg-slate-800"
          style="background-color: var(--bg-secondary);"
        >
          <span class="font-bold block mb-2 text-slate-300 dark:text-slate-600"
            >01</span
          >
          <span class="font-semibold text-sm">{t("custom.feat1.title")}</span>
        </div>
        <div
          class="h-40 rounded-3xl soft-shadow flex flex-col justify-center p-6 mt-8 dark:bg-slate-800"
          style="background-color: var(--bg-secondary);"
        >
          <span class="font-bold block mb-2 text-slate-300 dark:text-slate-600"
            >02</span
          >
          <span class="font-semibold text-sm">{t("custom.feat2.title")}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy / Quiet Tech Section -->
  <section
    id="philosophy"
    class="py-20 px-6 pl-16 pr-16 bg-slate-900 dark:bg-slate-950 text-white rounded-[2rem] mx-4 mb-4 overflow-hidden relative"
  >
    <!-- Subtle Ambient Glow -->
    <div
      class="absolute top-0 right-0 w-96 h-96 bg-yellow-400 blur-[150px] opacity-10 rounded-full -mr-48 -mt-48"
    >
    </div>

    <div class="max-w-4xl mx-auto relative z-10">
      <div class="mb-16">
        <h2 class="text-4xl font-bold mb-6 text-yellow-400 italic">
          {t("philosophy.title")}
        </h2>
        <p class="text-xl text-slate-300 max-w-3xl leading-relaxed">
          {t("philosophy.description")}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-x-16 gap-y-12">
        <!-- Feature 1 -->
        <div>
          <h4 class="font-bold text-xl mb-4 flex items-start gap-2">
            <span class="text-yellow-400">01</span>
            {t("philosophy.feat1.title")}
          </h4>
          <p class="text-slate-400 dark:text-slate-500 leading-relaxed">
            {t("philosophy.feat1.description")}
          </p>
        </div>

        <!-- Feature 2 -->
        <div>
          <h4 class="font-bold text-xl mb-4 flex items-start gap-2">
            <span class="text-yellow-400">02</span>
            {t("philosophy.feat2.title")}
          </h4>
          <p class="text-slate-400 dark:text-slate-500 leading-relaxed">
            {t("philosophy.feat2.description")}
          </p>
        </div>

        <!-- Feature 3 -->
        <div>
          <h4 class="font-bold text-xl mb-4 flex items-start gap-2">
            <span class="text-yellow-400">03</span>
            {t("philosophy.feat3.title")}
          </h4>
          <p class="text-slate-400 dark:text-slate-500 leading-relaxed">
            {t("philosophy.feat3.description")}
          </p>
        </div>

        <!-- Feature 4 -->
        <div>
          <h4 class="font-bold text-xl mb-4 flex items-start gap-2">
            <span class="text-yellow-400">04</span>
            {t("philosophy.feat4.title")}
          </h4>
          <p class="text-slate-400 dark:text-slate-500 leading-relaxed">
            {t("philosophy.feat4.description")}
          </p>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-slate-800">
        <p
          class="text-sm font-semibold text-slate-500 uppercase tracking-widest"
        >
          {t("philosophy.footer")}
        </p>
      </div>
    </div>
  </section>
</MainLayout>
