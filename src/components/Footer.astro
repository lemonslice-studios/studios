---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const privacyUrl = `${import.meta.env.BASE_URL}privacy-policy/`;
---

<footer class="py-20 px-6 text-center">
  <div class="max-w-6xl mx-auto border-t pt-16 flex flex-col md:flex-row justify-between items-center gap-8 dark:border-slate-800" style="border-color: var(--border-color);">
    <div class="flex items-center gap-3">
      <span class="font-extrabold text-xl tracking-tighter">
        Lemon Slice <span class="dark:text-slate-600" style="color: var(--text-tertiary);">Studios</span>
      </span>
      <a href="https://www.lemonslice.de/">
        <span class="text-sm dark:text-slate-600" style="color: var(--text-tertiary);">a division of lemon slice digital GmbH</span>
      </a>
    </div>
    <div class="flex gap-12 text-sm font-semibold uppercase tracking-widest dark:text-slate-500" style="color: var(--text-tertiary);">
      <a href={privacyUrl} class="hover:text-slate-900 dark:hover:text-slate-300 transition">{t('footer.privacy')}</a>
      <a href="https://www.lemonslice.de/#privacy" class="hover:text-slate-900 dark:hover:text-slate-300 transition">{t('footer.legal')}</a>
      <a href="mailto:hello@lemonslice.de" class="hover:text-slate-900 dark:hover:text-slate-300 transition">{t('footer.contact')}</a>
    </div>
  </div>
  <div>
    <p class="text-[11px] dark:text-slate-600 pt-8" style="color: var(--text-tertiary);">
      Android is a trademark of Google LLC.
    </p>
    <p class="text-[11px] dark:text-slate-600 pt-4" style="color: var(--text-tertiary);" set:html={t('footer.copyright')}>
    </p>
  </div>
</footer>
