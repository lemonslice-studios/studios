---
import IndexTemplate from '../components/IndexTemplate.astro';
---

<IndexTemplate />

<script>
  const preferredLangStorageKey = 'preferred-lang';
  const savedLang = localStorage.getItem(preferredLangStorageKey);
  const baseUrl = import.meta.env.BASE_URL;
  const jaPath = `${baseUrl}ja/`;

  if (savedLang === 'ja') {
    window.location.replace(jaPath);
  } else if (!savedLang) {
    const prefersJapanese = (
      navigator.languages || [navigator.language]
    ).some((lang) => typeof lang === 'string' && lang.toLowerCase().startsWith('ja'));

    if (prefersJapanese) {
      localStorage.setItem(preferredLangStorageKey, 'ja');
      window.location.replace(jaPath);
    } else {
      localStorage.setItem(preferredLangStorageKey, 'en');
    }
  }
</script>
