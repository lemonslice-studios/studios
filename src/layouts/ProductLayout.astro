---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// import FooterSimple from '../components/FooterSimple.astro';

interface Props {
  title: string;
  description?: string;
  favicon?: string;
}

const { title, description, favicon } = Astro.props;
---

<BaseLayout title={title} description={description} favicon={favicon}>
  <Header transparent={true} logoSize="md" compact={true}>
  </Header>
  <slot />
  <Footer/>

  <script>
    window.addEventListener('scroll', function () {
      const nav = document.getElementById('main-nav');
      if (nav) {
        if (window.scrollY > 50) {
          nav.classList.add('nav-shrunk');
        } else {
          nav.classList.remove('nav-shrunk');
        }
      }
    });
  </script>
</BaseLayout>
